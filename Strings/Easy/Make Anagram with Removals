class Solution {
    public static int remAnagram(String s1, String s2) {
        int[] count = new int[26];

        for (char c : s1.toCharArray()) {
            count[c - 'a']++;
        }

        for (char c : s2.toCharArray()) {
            count[c - 'a']--;
        }

        int result = 0;

        for (int i = 0; i < 26; i++) {
            result += Math.abs(count[i]);
        }

        return result;
    }
}
