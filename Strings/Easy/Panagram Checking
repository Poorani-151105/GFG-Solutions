class Solution {
    public static boolean checkPangram(String s) {
        boolean[] seen = new boolean[26];

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            if (c >= 'A' && c <= 'Z') {
                seen[c - 'A'] = true;
            } else if (c >= 'a' && c <= 'z') {
                seen[c - 'a'] = true;
            }
        }

        for (int i = 0; i < 26; i++) {
            if (!seen[i]) {
                return false;
            }
        }

        return true;
    }
}
