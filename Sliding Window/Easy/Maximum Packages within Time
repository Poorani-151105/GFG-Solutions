class Solution {
    public static int maxPackages(int[] arr, int totalTime) {
        int n = arr.length;

        if (totalTime >= n) {
            int sum = 0;
            for (int num : arr) {
                sum += num;
            }
            return sum;
        }

        int sum = 0;

        for (int i = 0; i < totalTime; i++) {
            sum += arr[i];
        }

        int max = sum;

        for (int i = totalTime; i < n; i++) {
            sum += arr[i];
            sum -= arr[i - totalTime];
            max = Math.max(max, sum);
        }

        return max;
    }
}
