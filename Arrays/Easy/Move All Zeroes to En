class Solution {
    void pushZerosToEnd(int[] arr) 
    {
        int[] newArr = new int[arr.length];
        int index = 0;

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] != 0) {
                newArr[index] = arr[i];
                index++;   
            }
        }

        for (int i = 0; i < arr.length; i++) {
            arr[i] = newArr[i];
        }
    }
}
