class Solution {
    public void segregateElements(int[] arr) {
        int[] temp = new int[arr.length];
        int index = 0;

        for (int num : arr) {
            if (num >= 0) {
                temp[index++] = num;
            }
        }

        for (int num : arr) {
            if (num < 0) {
                temp[index++] = num;
            }
        }

        for (int i = 0; i < arr.length; i++) {
            arr[i] = temp[i];
        }
    }
}
