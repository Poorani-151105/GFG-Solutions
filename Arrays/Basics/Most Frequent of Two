class Solution {
    public static int moreFrequent(List<Integer> arr, int x, int y) {
        int countX = 0;
        int countY = 0;

        for (int num : arr) {
            if (num == x) {
                countX++;
            }
            if (num == y) {
                countY++;
            }
        }

        if (countX > countY) {
            return x;
        } else if (countY > countX) {
            return y;
        } else {
            return Math.min(x, y);
        }
    }
}
